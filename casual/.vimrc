syntax on
inoremap ( () <left>
inoremap { {} <left>
inoremap [ [] <left>
inoremap " "" <left>
inoremap ' '' <left>
inoremap < <> <left>
inoremap <C-f> <Esc>:wq <CR>
nnoremap <C-s> :w <CR>
nnoremap <C-q> :q! <CR>
nnoremap <C-f> :wq <CR>
nnoremap <CR> i
set number
colorscheme desert
set mouse=a
set showmatch
set cursorline
set termguicolors
set completeopt=menu,menuone,noselect
